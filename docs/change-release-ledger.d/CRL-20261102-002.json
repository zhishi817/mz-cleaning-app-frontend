{
  "schema_version": 1,
  "crl": "CRL-20261102-002",
  "repository": "mobile",
  "title": "MZ-097 protected feedback draft recovery",
  "request": "Preserve deep-clean feedback text and photo references across failed saves and retries while requiring an exact authoritative cleaning-task source.",
  "outcome": "The Mobile client fails closed before upload when the exact source is unavailable, preserves owner-verified drafts and uploaded references, and prevents duplicate retry uploads.",
  "implementation": [
    "Use only explicit authoritative feedback source context and never a projected work-task identifier.",
    "Persist versioned feedback drafts with exact user and property ownership checks plus serialized writes.",
    "Retain local previews and acknowledged remote references until the business save succeeds.",
    "Accept a strict incremental registration without rewriting the historical ledger."
  ],
  "impact_dependencies": [
    "No backend, database, migration, native dependency, package manifest, lockfile, environment, or production-data change.",
    "Existing Root media authorization and feedback-source validation remain authoritative.",
    "Physical-device, camera, gallery, weak-network, native-build, EAS, and OTA validation remain outside this code-only PR."
  ],
  "validation": [
    "Focused feedback/storage/API suites passed: 4 suites and 61 tests.",
    "Mobile complete gate passed on the exact business-code candidate: 83 suites and 790 tests.",
    "Incremental ledger unit tests cover omitted paths, wrong paths, malformed registrations, append-only lineage, exact hunks, commit binding, and safe text."
  ],
  "risks": [
    "A missing, malformed, stale, duplicated, over-broad, or hunk-mismatched registration blocks release.",
    "The historical ledger remains byte-for-byte unchanged and is not included in this change.",
    "Device and real-network behavior still require a later release validation step."
  ],
